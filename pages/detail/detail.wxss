.page { padding-bottom: 60rpx; }

.hero-head { display: flex; align-items: center; }
.hero-name { font-size: 36rpx; font-weight: 800; }
.hero-meta { display: flex; flex-wrap: wrap; gap: 24rpx; margin: 16rpx 0; font-size: 26rpx; }
.rating { color: #FF9500; font-weight: 700; }
.cost { color: #FF6B35; font-weight: 700; }
.dist { color: #18A058; font-weight: 600; }
.travel { color: #888; }
.hero-line { font-size: 25rpx; color: #666; margin-top: 10rpx; }
.hero-actions { display: flex; gap: 20rpx; margin-top: 26rpx; }
.hero-actions .btn { flex: 1; }

.map-card { padding: 12rpx; }
.map { width: 100%; height: 360rpx; border-radius: 16rpx; }

.photo-swiper {
  height: 300rpx;
  margin: 20rpx 24rpx;
  border-radius: 18rpx;
  overflow: hidden;
}
.photo { width: 100%; height: 300rpx; background: #FFF1E8; }

.menu-empty { text-align: center; padding: 48rpx 32rpx; }
.menu-empty-emoji { font-size: 64rpx; }
.menu-empty-title { margin-top: 12rpx; font-size: 28rpx; font-weight: 700; color: #7A4A2B; }
.menu-empty-sub { margin-top: 10rpx; font-size: 23rpx; color: #B08060; line-height: 1.6; }

.dish-card { padding: 20rpx 26rpx; }
.dish-row { display: flex; align-items: center; }
.dish-emoji { font-size: 44rpx; margin-right: 20rpx; }
.dish-info { flex: 1; }
.dish-name { font-size: 28rpx; font-weight: 600; }
.dish-star {
  font-size: 20rpx; color: #FF6B35; background: #FFE9DD;
  padding: 2rpx 12rpx; border-radius: 12rpx; margin-left: 8rpx; font-weight: 400;
}
.dish-sub { font-size: 22rpx; color: #B08060; margin-top: 4rpx; }
.dish-price { font-size: 30rpx; font-weight: 800; color: #FF6B35; }
.dish-price-tip { font-size: 22rpx; font-weight: 400; color: #C0A08F; }

.tip { text-align: center; font-size: 21rpx; color: #C0A08F; padding: 16rpx 40rpx; }

.hero-actions-second { margin-top: 12rpx; }
.hero-note { margin-top: 10rpx; font-size: 20rpx; color: #B08060; line-height: 1.5; }

/* 地址行上的「复制」小标签 */
.copy-tag {
  color: #FF6B35;
  font-size: 24rpx;
  margin-left: 12rpx;
  border: 1rpx solid #FFD2B8;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}

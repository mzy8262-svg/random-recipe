<view class="page">

  <!-- 离线提示：菜库打包在本地，断网也能抽签/筛选 -->
  <view class="offline-tip" wx:if="{{!online}}">
    <text class="offline-icon">📴</text>
    <text class="offline-text">当前离线。抽签、筛选照常可用；定位、附近商家和导航需要联网。</text>
  </view>

  <!-- 定位区 -->
  <view class="card loc-card">
    <view class="loc-row">
      <view class="loc-info">
        <view class="loc-text">📍 {{locText}}</view>
        <view class="loc-source" wx:if="{{locSourceText}}">{{locSourceText}}</view>
      </view>
      <view class="loc-actions">
        <view class="btn btn-ghost btn-sm" bindtap="onRelocate">重新定位</view>
        <view class="btn btn-ghost btn-sm" bindtap="onChooseOnMap">地图选点</view>
        <view class="btn btn-ghost btn-sm" bindtap="toggleAddrBox">搜地址</view>
      </view>
    </view>

    <view class="loc-hint" wx:if="{{locState === 'ok' && locHint}}">
      <text>{{locHint}}</text>
    </view>

    <view class="loc-fail" wx:if="{{locState === 'fail'}}">
      <text class="loc-fail-text">{{locFailText}}</text>
      <view class="btn btn-primary btn-sm" bindtap="onOpenSetting">去开启</view>
    </view>

    <view class="addr-box" wx:if="{{showAddrBox}}">
      <input class="addr-input" placeholder="输入地址，如：济南市历下区泉城路" value="{{addrInput}}" bindinput="onAddrInput" confirm-type="search" bindconfirm="onAddrSearch" />
      <view class="btn btn-primary btn-sm" bindtap="onAddrSearch">搜索</view>
      <view class="addr-item" wx:for="{{addrResults}}" wx:key="name" data-idx="{{index}}" bindtap="onPickAddr">
        <view class="addr-name">{{item.name}}</view>
        <view class="addr-addr">{{item.address}}</view>
      </view>
    </view>

    <view class="radius-row">
      <text class="radius-label">搜索范围</text>
      <view class="chip {{radius == item.km ? 'active' : ''}}" wx:for="{{radiusSteps}}" wx:key="km" data-km="{{item.km}}" bindtap="onRadius">{{item.label}}</view>
    </view>
  </view>

  <!-- 场景 -->
  <view class="section-title">什么时候吃？<text class="hint">按当前时间已自动选好</text></view>
  <scroll-view scroll-x class="scene-scroll">
    <view class="chip {{scene === item.id ? 'active' : ''}}" wx:for="{{scenes}}" wx:key="id" data-id="{{item.id}}" bindtap="onPickScene">
      {{item.emoji}} {{item.name}}
    </view>
  </scroll-view>

  <!-- 品类 -->
  <view class="section-title">吃什么类型？<text class="hint" bindtap="clearCats">清空</text></view>
  <view class="chip-wrap pad-h">
    <view class="chip {{catOn[item.id] ? 'active' : ''}}" wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" bindtap="onPickCat">
      {{item.emoji}} {{item.name}}
    </view>
  </view>

  <!-- 菜系 -->
  <view class="section-title">吃什么菜系？<text class="hint" bindtap="clearCuisine">清空</text></view>
  <view class="chip-wrap pad-h">
    <view class="chip {{cuisineId === item.id ? 'active' : ''}}" wx:for="{{cuisines}}" wx:key="id" data-id="{{item.id}}" bindtap="onPickCuisine">
      {{item.emoji}} {{item.name}}
    </view>
  </view>

  <!-- 预算 -->
  <view class="section-title">花多少钱？</view>
  <view class="chip-wrap pad-h">
    <view class="chip {{budgetId === item.id ? 'active' : ''}}" wx:for="{{budgets}}" wx:key="id" data-id="{{item.id}}" bindtap="onPickBudget">
      {{item.name}}
    </view>
  </view>

  <!-- 标签 -->
  <view class="section-title">有什么要求？</view>
  <view class="chip-wrap pad-h">
    <view class="chip {{tagOn[item.id] ? 'active' : ''}}" wx:for="{{tags}}" wx:key="id" data-id="{{item.id}}" bindtap="onPickTag">
      {{item.emoji}} {{item.name}}
    </view>
  </view>

  <!-- 抽签老虎机 -->
  <view class="card slot-card">
    <view class="slot-machine">
      <view class="slot-lights">
        <view class="light" wx:for="{{[1,2,3,4,5,6,7,8]}}" wx:key="*this"></view>
      </view>
      <view class="slot-window {{slotRunning ? 'spinning' : ''}}">
        <text user-select>{{slotText}}</text>
      </view>
      <view class="slot-pool">当前可选 <text class="num">{{poolCount}}</text> 道菜<text class="pool-src" wx:if="{{poolSourceText}}">（{{poolSourceText}}）</text></view>
    </view>

    <view class="result-box" wx:if="{{result}}">
      <view class="result-reason">{{result.reason}}</view>
      <view class="result-kcal">
        <text wx:if="{{result.dish.price}}">💰 约 ¥{{result.dish.price}} · </text>
        <text wx:if="{{result.dish.kcal}}">🔥 约 {{result.dish.kcal}} 千卡</text>
      </view>
      <view class="result-merchants" wx:if="{{result.merchants.length}}">
        <view class="rm-title">附近能吃到：</view>
        <view class="rm-item" wx:for="{{result.merchants}}" wx:key="id" data-idx="{{index}}" bindtap="goDetailFromResult">
          <text class="rm-name" user-select>{{item.name}}</text>
          <text class="rm-dist" wx:if="{{item.distText}}">{{item.distText}}</text>
          <text class="rm-meituan" data-name="{{item.name}}" catchtap="onOpenMeituan">美团看价</text>
        </view>
      </view>
      <view class="rm-empty" wx:elif="{{resultLoading}}">正在找附近能吃到这道菜的店…</view>
      <view class="rm-empty" wx:elif="{{resultEmpty}}">附近没搜到这道菜，去下面商家列表里看看</view>
      <view class="result-actions">
        <text class="act-btn" bindtap="onOpenMeituanDish">🛵 去美团看价</text>
        <text class="act-btn" bindtap="onCopyForTaobao">🛒 去淘宝闪购</text>
      </view>
      <view class="act-hint">高德没有菜品价格，点上面按钮去美团/淘宝看实时价；会先问你要不要复制店名；复制成功会提示「已复制：店名」，粘贴即可搜索。菜名/店名也可以长按文字直接选中复制</view>
    </view>

    <button class="btn btn-primary btn-block spin-btn" bindtap="spin" disabled="{{slotRunning}}">
      {{slotRunning ? '抽签中…' : '🎰 开始抽'}}
    </button>
  </view>

  <!-- 按菜系快抽：点一下，直接从该菜系里随机一道 -->
  <view class="card quick-card">
    <view class="section-title">🎯 按菜系快抽<text class="hint">点一下，直接从该菜系里随机</text></view>
    <view class="chip-wrap">
      <view class="chip chip-sm {{cuisineId === item.id ? 'active' : ''}}" wx:for="{{cuisines}}" wx:key="id" data-id="{{item.id}}" bindtap="onQuickCuisine">
        {{item.emoji}} {{item.name}}
      </view>
    </view>
  </view>

  <!-- 范围内菜品全览：范围内所有商家的推荐菜都列出来，点一下直接选中 -->
  <view class="card range-dish-card" wx:if="{{rangeDishTotal}}">
    <view class="section-title rd-title">
      🍽️ 范围内菜品
      <text class="rd-count">{{rangeDishTotal}} 道</text>
      <text class="rd-toggle" bindtap="onToggleRangeDishes">{{showAllRangeDishes ? '收起' : '展开全部'}}</text>
    </view>
    <view class="rd-list">
      <view class="rd-item" wx:for="{{showAllRangeDishes ? rangeDishRows : rangeDishPreview}}" wx:key="name" data-idx="{{item.idx}}" bindtap="onTapRangeDish">
        <text class="rd-name">{{item.emoji}} {{item.name}}</text>
        <text class="rd-price">{{item.priceText}}</text>
        <text class="rd-mer">{{item.merName}} {{item.merDisText}}</text>
      </view>
    </view>
    <view class="rd-more" wx:if="{{!showAllRangeDishes && rangeDishTotal > 12}}" bindtap="onToggleRangeDishes">
      还有 {{rangeDishTotal - 12}} 道，点这里展开全部 ▾
    </view>
    <view class="rd-hint">范围调大（5km / 10km）或换菜系，菜品会跟着变多</view>
  </view>

  <!-- 商家列表 -->
  <view class="section-title">
    附近商家
    <picker mode="selector" range="{{sortOptions}}" range-key="name" value="{{sortIndex}}" bindchange="onSortChange">
      <text class="hint">排序 ▾</text>
    </picker>
  </view>

  <view class="list-tip" wx:if="{{listTip}}">{{listTip}}</view>
  <view class="list-tip" wx:if="{{rangeDishesLoading}}">正在补全范围内商家与菜品…</view>

  <view class="card merchant-card" wx:for="{{merchants}}" wx:key="id" data-idx="{{index}}" bindtap="goDetail">
    <view class="m-main">
      <image class="m-photo" wx:if="{{item.photos.length}}" src="{{item.photos[0]}}" mode="aspectFill" lazy-load />
      <view class="m-body">
        <view class="m-head">
          <text class="m-name">{{item.name}}</text>
        </view>
        <view class="m-meta">
          <text wx:if="{{item.rating}}" class="m-rating">★ {{item.rating}}</text>
          <text wx:if="{{item.cost}}" class="m-cost">人均 ¥{{item.cost}}</text>
          <text class="m-dist">{{item.distText}}</text>
          <text class="m-walk" wx:if="{{item.walkText}}">{{item.walkText}}</text>
        </view>
        <view class="m-tags">
          <text class="m-tag" wx:if="{{item.cuisine}}">{{item.cuisine}}</text>
          <text class="m-open" wx:if="{{item.openTime}}">{{item.openTime}}</text>
        </view>
        <view class="m-dishes" wx:if="{{item.dishes.length}}">
          <text class="m-dish" wx:for="{{item.dishes}}" wx:for-item="d" wx:key="*this">{{d}}</text>
        </view>
        <view class="m-addr">{{item.address}}</view>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!merchants.length && !loadingMerchants}}">
    <view class="emoji">{{locState === 'ok' ? '🍽️' : '📍'}}</view>
    <view wx:if="{{locState === 'ok'}}">这个范围里暂时没找到商家</view>
    <view wx:else>还没拿到你的位置</view>
    <view class="hint">试试把范围调到 2km / 5km，或点「地图选点」把位置选准</view>
  </view>

  <view class="load-more" wx:if="{{merchants.length}}">
    <view wx:if="{{loadingMerchants}}">加载中…</view>
    <view wx:elif="{{exhausted}}">— 已经到底啦 —</view>
    <view class="btn btn-ghost" wx:else bindtap="loadMore">加载更多</view>
  </view>

  <!-- 复制失败兜底（C 方案）：文字可长按选中复制 -->
  <view class="copy-mask" wx:if="{{copyPanel.show}}" catchtap="closeCopyPanel">
    <view class="copy-body" catchtap="noop">
      <view class="copy-title">{{copyPanel.title}}</view>
      <view class="copy-hint">长按下面的文字 → 全选 / 复制</view>
      <view class="copy-text"><text user-select>{{copyPanel.text}}</text></view>
      <button class="btn btn-primary btn-block" bindtap="closeCopyPanel">关闭</button>
    </view>
  </view>

</view>

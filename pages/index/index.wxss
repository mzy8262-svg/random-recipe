.page { padding-bottom: 40rpx; }
.pad-h { padding: 0 24rpx; }

/* 离线提示条 */
.offline-tip {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin: 0 24rpx 16rpx;
  padding: 16rpx 20rpx;
  background: #FFF4E5;
  border-radius: 16rpx;
}
.offline-icon { font-size: 26rpx; line-height: 1.5; }
.offline-text { flex: 1; font-size: 23rpx; color: #B25E09; line-height: 1.5; }

/* 定位卡 */
.loc-card { padding: 24rpx; }
.loc-row { display: flex; justify-content: space-between; align-items: center; }
.loc-text { font-size: 30rpx; font-weight: 600; }
.loc-source { font-size: 22rpx; color: #B08060; margin-top: 4rpx; }
.loc-actions { display: flex; gap: 12rpx; flex-wrap: wrap; justify-content: flex-end; max-width: 420rpx; }
.btn-sm { padding: 10rpx 24rpx; font-size: 24rpx; }

.loc-hint {
  margin-top: 16rpx;
  padding: 12rpx 18rpx;
  background: #FFF7EC;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #C05621;
  line-height: 1.5;
}

.list-tip {
  margin: 4rpx 0 16rpx;
  padding-left: 4rpx;
  font-size: 22rpx;
  color: #8C8C8C;
}

.loc-fail {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 16rpx 20rpx;
  background: #FFF1E8;
  border-radius: 14rpx;
}
.loc-fail-text { flex: 1; font-size: 23rpx; color: #C05621; line-height: 1.5; }

.addr-box { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; margin-top: 20rpx; }
.addr-input {
  flex: 1;
  min-width: 320rpx;
  background: #FFF4EC;
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
  font-size: 26rpx;
}
.addr-item { width: 100%; padding: 14rpx 8rpx; border-bottom: 1rpx solid #F5EDE6; }
.addr-name { font-size: 26rpx; font-weight: 600; }
.addr-addr { font-size: 22rpx; color: #999; margin-top: 4rpx; }

.radius-row { display: flex; align-items: center; flex-wrap: wrap; margin-top: 20rpx; }
.radius-label { font-size: 24rpx; color: #888; margin-right: 12rpx; }

/* 场景横滑 */
.scene-scroll { white-space: nowrap; padding: 0 16rpx; }
.scene-scroll .chip { display: inline-flex; margin: 8rpx 8rpx; }

/* 老虎机 */
.slot-card { background: linear-gradient(160deg, #FF8E53, #FF6B35); color: #fff; }
.slot-machine {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 20rpx;
  padding: 24rpx;
  text-align: center;
}
.slot-lights { display: flex; justify-content: center; gap: 18rpx; margin-bottom: 16rpx; }
.light {
  width: 14rpx; height: 14rpx; border-radius: 50%;
  background: #FFE8A3;
  animation: blink 1.2s infinite;
}
.light:nth-child(2n) { animation-delay: 0.3s; }
.light:nth-child(3n) { animation-delay: 0.6s; }
@keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

.slot-window {
  background: #fff;
  color: #FF6B35;
  border-radius: 16rpx;
  padding: 32rpx 20rpx;
  font-size: 40rpx;
  font-weight: 800;
  min-height: 60rpx;
}
.slot-window.spinning { opacity: 0.85; }
.slot-pool { margin-top: 14rpx; font-size: 24rpx; opacity: 0.9; }
.slot-pool .num { font-weight: 700; font-size: 28rpx; }
.slot-pool .pool-src { font-size: 22rpx; opacity: 0.85; }

.result-box {
  background: rgba(255, 255, 255, 0.95);
  color: #7A4A2B;
  border-radius: 16rpx;
  padding: 22rpx;
  margin-top: 22rpx;
  font-size: 25rpx;
}
.result-reason { font-size: 24rpx; color: #B08060; }
.result-kcal { margin-top: 10rpx; font-weight: 600; }
.result-merchants { margin-top: 14rpx; }
.rm-title { font-size: 23rpx; color: #B08060; margin-bottom: 6rpx; }
.rm-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
  border-top: 1rpx solid #F5EDE6;
  font-size: 24rpx;
}
.rm-name { flex: 1; margin-right: 12rpx; }
.rm-dist { font-size: 22rpx; color: #B08060; }
.rm-empty { margin-top: 12rpx; font-size: 23rpx; color: #B08060; }

.spin-btn {
  margin-top: 26rpx;
  font-size: 34rpx;
  font-weight: 800;
  padding: 24rpx 0;
  background: #fff;
  color: #FF6B35;
}
.spin-btn[disabled] { opacity: 0.7; }

/* 商家卡 */
.merchant-card { padding: 22rpx 26rpx; }
.m-main { display: flex; }
.m-photo {
  width: 150rpx;
  height: 150rpx;
  border-radius: 14rpx;
  margin-right: 18rpx;
  background: #FFF1E8;
  flex-shrink: 0;
}
.m-body { flex: 1; min-width: 0; }
.m-head { display: flex; align-items: center; }
.m-name { font-size: 29rpx; font-weight: 700; }
.m-meta { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 10rpx; font-size: 24rpx; color: #888; }
.m-rating { color: #FF9500; font-weight: 700; }
.m-cost { color: #FF6B35; }
.m-walk { color: #B08060; }
.m-tags { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; margin-top: 8rpx; }
.m-tag { font-size: 22rpx; color: #FF6B35; background: #FFF1E8; border-radius: 8rpx; padding: 2rpx 10rpx; }
.m-open { font-size: 21rpx; color: #aaa; }
.m-dishes { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 8rpx; }
.m-dish { font-size: 21rpx; color: #8A6A50; background: #FAF4EE; border-radius: 8rpx; padding: 2rpx 10rpx; }
.m-addr { margin-top: 8rpx; font-size: 23rpx; color: #aaa; }

.load-more { text-align: center; padding: 30rpx; color: #B08060; font-size: 25rpx; }
.hint { color: #B08060; font-size: 23rpx; font-weight: 400; }

/* 按菜系快抽卡片 */
.quick-card { margin: 8rpx 24rpx 24rpx; padding: 20rpx 8rpx 10rpx; }
.quick-card .section-title { margin: 0 12rpx 8rpx; }
.chip-sm { padding: 8rpx 20rpx; font-size: 24rpx; margin: 6rpx; }

/* 范围内菜品全览 */
.range-dish-card { margin: 8rpx 24rpx 20rpx; padding: 22rpx 22rpx 16rpx; }
.rd-title { margin: 0 0 10rpx; }
.rd-count { color: #FF6B35; font-size: 24rpx; font-weight: 700; margin-left: 8rpx; }
.rd-toggle { margin-left: auto; color: #FF6B35; font-size: 24rpx; font-weight: 600; padding: 6rpx 4rpx; }
.rd-list { display: flex; flex-direction: column; }
.rd-item { display: flex; align-items: baseline; gap: 12rpx; padding: 12rpx 0; border-bottom: 1rpx solid #F6EDE5; }
.rd-item:last-child { border-bottom: none; }
.rd-name { font-size: 27rpx; color: #333; flex: 1; min-width: 0; }
.rd-price { font-size: 22rpx; color: #FF6B35; }
.rd-mer { font-size: 21rpx; color: #A88E78; max-width: 260rpx; text-align: right; }
.rd-more { text-align: center; padding: 14rpx 0 4rpx; color: #FF6B35; font-size: 24rpx; }
.rd-hint { padding: 10rpx 0 2rpx; color: #B08060; font-size: 21rpx; }
/* 美团看价 / 淘宝闪购 */
.rm-meituan { margin-left: auto; flex: none; font-size: 21rpx; color: #FF6B35; background: #FFF1E8; border-radius: 999rpx; padding: 4rpx 16rpx; }
.result-actions { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 16rpx; }
.act-btn { font-size: 23rpx; color: #FF6B35; background: #FFF6ED; border: 1rpx solid #FFD9BD; border-radius: 999rpx; padding: 8rpx 20rpx; }
.act-hint { margin-top: 10rpx; font-size: 20rpx; color: #B08060; line-height: 1.5; }
